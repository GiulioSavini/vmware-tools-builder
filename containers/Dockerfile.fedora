FROM fedora:latest

LABEL maintainer="Infrastructure Team"
LABEL description="Build container for open-vm-tools .rpm (Fedora)"

# Niente "Development Tools" group: trascina openh264 dal repo Cisco
# (ciscobinary.openh264.org, solo HTTP) che dietro proxy che filtra :80 va in
# timeout e blocca tutto. Disabilitiamo il repo Cisco e installiamo solo il
# toolchain esplicito, con --setopt=install_weak_deps=False per evitare la coda
# di pacchetti opzionali (es. gstreamer1-plugin-openh264).
RUN dnf -y --setopt=install_weak_deps=False install dnf-plugins-core && \
    dnf config-manager --set-disabled fedora-cisco-openh264 2>/dev/null || true && \
    dnf -y --setopt=install_weak_deps=False install \
        gcc \
        gcc-c++ \
        make \
        pkgconf-pkg-config \
        gettext \
        patch \
        automake \
        autoconf \
        libtool \
        libtool-ltdl-devel \
        glib2-devel \
        pam-devel \
        openssl-devel \
        libxml2-devel \
        xmlsec1-devel \
        libmspack-devel \
        fuse3-devel \
        systemd-devel \
        libudev-devel \
        libdrm-devel \
        libtirpc-devel \
        rpcgen \
        curl \
        wget \
        git \
        rpm-build \
        ca-certificates \
    && dnf clean all

COPY build-inside-container.sh /build.sh
RUN chmod +x /build.sh

VOLUME /output
ENTRYPOINT ["/build.sh"]
